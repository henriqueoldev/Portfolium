---
import * as userProfile from "../config/UserResume.md";
import {Content} from "../config/UserResume.md";
import Layout from "../layouts/Layout.astro";
import Liner from '../components/UI/Liner.astro'
import userData from "../config/UserData.json";
---

<Layout title="Resume">
    <section class="container p-2 text-2xl lg:text-3xl">
        <div class="flex justify-between">
            <h1 class="font-bold">{userProfile.frontmatter.title}</h1>
            <h1 id="date" class="text-2xl font-bold">{userProfile.frontmatter.date?.toISOString().split('T')[0]}</h1>
        </div>
        <div class="flex items-baseline gap-3 w-full my-3">
            <div class="">
                <h1 class="text-center sm:text-left text-4xl 2xl:text-5xl">{userData.name}</h1>
            </div>
        </div>
        <Liner/>
        <div class="text-lg text-justify mdContent">
            <Content/>
        </div>
    </section>
</Layout>

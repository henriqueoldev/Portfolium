---
import { Content, frontmatter } from "../config/UserResume.md";
import ContentPage from "../components/UI/ContentPage.astro";
import Layout from "../layouts/Layout.astro";
import userData from "../config/UserData.json";
---

<Layout title="Resume">
  <ContentPage
    title={userData.name}
    subtitle={`Resume · ${userData.shortDesc}`}
    date={frontmatter.date}
  >
    <Content />
  </ContentPage>
</Layout>

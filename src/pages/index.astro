---
import Container from "../components/UI/Container.astro"
import ProfileCard from "../components/UI/ProfileCard.astro"
import Layout from "../layouts/Layout.astro"
import userData from "../config/UserData.json"
import ContentSection from "../components/UI/ContentSection.astro"
import GithubRepos from "../components/Utils/GithubRepos.astro"
import LocalProjects from "../components/Utils/LocalProjects.astro"
import Spinner from "../components/UI/Spinner.astro"
Spinner
---

<Layout>
	<Container>
		<ProfileCard title={userData.name} desc={userData.description} img={userData.profilePicture} socialLinks={userData.socialLinks}/>
		<ContentSection title="Projects">
			<LocalProjects/>
		</ContentSection>
		<ContentSection title="Github">
			<GithubRepos githubUserAPIURL={userData.githubAPI} server:defer>
				<div slot="fallback" class="col-span-full flex justify-center items-center">
					<div class="w-[10%] h-auto aspect-square">
						<Spinner/>
					</div>
				</div>
			</GithubRepos>
		</ContentSection>
	</Container>
</Layout>
---
import { FileTextIcon, XIcon } from "@phosphor-icons/react/dist/ssr";
import DefaultButton from "./DefaultButton.astro";
import LocalProjectsList from "../Utils/LocalProjectsList.astro";
---

<div
  id="modal"
  class="fixed inset-0 z-40 hidden bg-bg-light/60 backdrop-blur-sm dark:bg-bg-dark/60"
  role="dialog"
  aria-modal="true"
  aria-label="Projects menu"
>
  <button
    type="button"
    class="absolute inset-0 h-full w-full cursor-default"
    data-action="close-menu"
    aria-label="Close projects menu"
    tabindex="-1"
  ></button>

  <div
    id="modalNav"
    class="relative ml-auto flex h-full w-full flex-col bg-bg-light shadow-xl dark:bg-bg-dark md:max-w-md"
  >
    <div class="flex h-14 shrink-0 items-center justify-between gap-2 border-b border-fg-light-400 p-2 dark:border-fg-dark-700">
      <p class="pl-1 text-lg font-medium">Projects</p>
      <DefaultButton label="Close projects menu" action="close-menu">
        <XIcon aria-hidden="true" />
      </DefaultButton>
    </div>

    <ul class="flex-1 overflow-y-auto p-2">
      <LocalProjectsList />
    </ul>

    <div class="shrink-0 border-t border-fg-light-400 p-2 dark:border-fg-dark-700">
      <a
        href="/resume"
        class="flex items-center justify-between gap-2 rounded-lg bg-primary-600 px-3 py-3 font-semibold text-white transition-colors hover:bg-primary-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      >
        <span>Resume</span>
        <FileTextIcon class="shrink-0" aria-hidden="true" />
      </a>
    </div>
  </div>
</div>

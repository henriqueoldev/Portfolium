---
import { UserListIcon, XIcon } from "@phosphor-icons/react"
import LocalProjectsList from "../Utils/LocalProjectsList.astro"
import DefaultButton from "./DefaultButton.astro"
---
<nav id="modal" class="hidden fixed w-full h-screen bg-bg-light/50 dark:bg-bg-dark/50 z-10 backdrop-blur-[.1rem] flex">
    <div id="closeModal" class="w-[0%] md:w-[200%]"></div>
    <div id="modalNav" class="bg-bg-light dark:bg-bg-dark w-full overflow-hidden">
        <div class="flex h-12 text-3xl w-full p-2 items-center justify-between group">
            <DefaultButton btnId="closeModal">
                <XIcon/>
            </DefaultButton>
        </div>
        <ul>
            <LocalProjectsList/>
        </ul>
    </div>
</nav>

<script>
    import { gsap } from "gsap";
    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('#closeModal')?.forEach((item) => {
            item.addEventListener('mousedown', () => {
                gsap.timeline()
                .to(
                    '#modalNav',
                    {x: '100%', duration: .2}
                )
                .to(
                    '#modal',
                    {opacity: 0, duration: .2}
                )
                .set(
                    '#modal',
                    {display: 'none'}
                )
            })
        })
    })
</script>
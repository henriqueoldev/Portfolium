---
import Liner from "./Liner.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="mt-6">
  <h2 class="text-3xl 2xl:text-4xl">{title}</h2>
  <div class="mb-2 mt-1"><Liner flush /></div>

  <div class="grid w-full grid-cols-1 content-center gap-2 p-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <slot />
  </div>
</section>

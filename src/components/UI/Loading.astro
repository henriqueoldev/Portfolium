---
import Spinner from "./Spinner.astro";
---

<div
  class="loading fixed inset-0 z-50 flex items-center justify-center bg-bg-light dark:bg-bg-dark"
  role="status"
  aria-live="polite"
  transition:persist="loading"
>
  <div class="size-16"><Spinner /></div>
  <span class="sr-only">Loading</span>
</div>

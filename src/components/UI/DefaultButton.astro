---
interface Props {
  /** Accessible name — every icon-only button needs one. */
  label: string;
  action?: "home" | "theme" | "menu" | "close-menu";
}

const { label, action } = Astro.props;
---

<button
  type="button"
  class="btn"
  aria-label={label}
  title={label}
  data-action={action}
>
  <slot />
</button>

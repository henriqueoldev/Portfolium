---
interface Props {
  /** Fades only to the right — used inside article headers. */
  flush?: boolean;
}

const { flush = false } = Astro.props;
---

<div
  class:list={[
    "liner h-[3px] w-full rounded-lg bg-linear-to-r",
    flush
      ? "from-primary-500 to-transparent"
      : "from-transparent via-primary-500 to-transparent sm:from-primary-500 sm:via-primary-500 sm:to-transparent",
  ]}
  aria-hidden="true"
>
</div>

---
interface Props {
  title: String;
  subTitle: String;
}
const { title, subTitle } = Astro.props;
import { ListIcon, HouseSimpleIcon, SunDimIcon } from "@phosphor-icons/react";
import DefaultButton from "./DefaultButton.astro";
---

<header class="flex justify-between items-center p-5 bg-fg-light dark:bg-fg-dark w-screen shadow-sm">
  <a href="/" class="flex flex-col">
    <h1 class="bg-primary-500 flex gap-3 items-center pl-1 font-medium text-3xl w-fit text-text-light after:inline-block after:w-5 after:h-9 after:bg-linear-to-r after:from-transparent after:to-primary-600 after:to-70%">
      {title}
    </h1>
    <h3 class="max-w-xl pl-1">
      {subTitle}
    </h3>
  </a>
  <nav>
    <ul class="flex gap-2 text-3xl text-text-light dark:text-text-dark">
      <li>
        <DefaultButton btnId="btnHome"><HouseSimpleIcon /></DefaultButton>
      </li>
      <li><DefaultButton btnId="btnTheme"><SunDimIcon /></DefaultButton></li>
      <li><DefaultButton btnId="btnMenu"><ListIcon /></DefaultButton></li>
    </ul>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const btnHome = document.getElementById("btnHome");
  btnHome?.addEventListener("mousedown", () => {
    window.location.href = "/";
  });

  const btnTheme = document.getElementById("btnTheme");
  btnTheme?.addEventListener("mousedown", () => {
    document.querySelector('html')?.classList.toggle('dark')
		localStorage.setItem('theme', localStorage.getItem('theme') == 'dark' ? 'light' : 'dark')
    document.querySelector('meta[name="color-scheme"]')?.setAttribute("content", localStorage.getItem('theme') || 'dark')
  });

  const btnMenu = document.getElementById("btnMenu");
  btnMenu?.addEventListener('mousedown', () => {
    document.getElementById('modal')?.classList.remove('hidden')
  })
  })
</script>

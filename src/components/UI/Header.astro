---
interface Props {
  title: String;
  subTitle: String;
}
const { title, subTitle } = Astro.props;
import { ListIcon, HouseSimpleIcon, SunDimIcon } from "@phosphor-icons/react";
import DefaultButton from "./DefaultButton.astro";
---

<header class="flex justify-between items-center p-5 bg-gray-200 w-screen shadow-sm">
  <a href="/" class="flex flex-col">
    <h1 class="bg-emerald-400 flex gap-3 items-center pl-1 text-3xl w-fit text-black after:inline-block after:w-5 after:h-9 after:bg-linear-to-r after:from-transparent after:to-emerald-500 after:to-70%">
      {title}
    </h1>
    <h3 class="max-w-xl pl-1">
      {subTitle}
    </h3>
  </a>
  <nav>
    <ul class="flex gap-2 text-3xl">
      <li>
        <DefaultButton btnId="btnHome"><HouseSimpleIcon /></DefaultButton>
      </li>
      <li><DefaultButton btnId="btnTheme"><SunDimIcon /></DefaultButton></li>
      <li><DefaultButton btnId="btnMenu"><ListIcon /></DefaultButton></li>
    </ul>
  </nav>
</header>

<script>
  const btnHome = document.getElementById("btnHome");
  btnHome?.addEventListener("mousedown", () => {
    window.location.href = "/";
  });
</script>

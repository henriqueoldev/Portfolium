---
import { HouseSimpleIcon, ListIcon, SunDimIcon } from "@phosphor-icons/react/dist/ssr";
import DefaultButton from "./DefaultButton.astro";

interface Props {
  title: string;
  subTitle: string;
}

const { title, subTitle } = Astro.props;
---

<header
  class="sticky top-0 z-30 flex w-full items-center justify-between gap-4 bg-fg-light/90 p-5 shadow-sm backdrop-blur dark:bg-fg-dark/90"
>
  <a href="/" class="flex min-w-0 flex-col">
    <h1
      class="flex w-fit items-center gap-3 bg-primary-500 pl-1 text-3xl font-medium text-gray-900 after:inline-block after:h-9 after:w-5 after:bg-linear-to-r after:from-transparent after:to-primary-600 after:to-70%"
    >
      {title}
    </h1>
    <p class="max-w-xl pl-1 text-sm text-text-light/70 dark:text-text-dark/70">
      {subTitle}
    </p>
  </a>

  <nav aria-label="Main">
    <ul class="flex gap-2 text-3xl text-text-light dark:text-text-dark">
      <li>
        <DefaultButton label="Go to home page" action="home">
          <HouseSimpleIcon aria-hidden="true" />
        </DefaultButton>
      </li>
      <li>
        <DefaultButton label="Switch color theme" action="theme">
          <SunDimIcon aria-hidden="true" />
        </DefaultButton>
      </li>
      <li>
        <DefaultButton label="Open projects menu" action="menu">
          <ListIcon aria-hidden="true" />
        </DefaultButton>
      </li>
    </ul>
  </nav>
</header>

---
interface Props {
  title: string;
  linkUrl: string;
  description?: string | null;
  imageUrl?: string;
  tags?: string[];
  stars?: number;
  target?: string;
}

const { title, linkUrl, description, imageUrl, tags = [], stars, target } = Astro.props;
const isExternal = target === "_blank";
---

<a
  class="contentCard group flex h-full w-full flex-col justify-between gap-3 rounded-lg bg-fg-light p-3 transition-shadow duration-200 hover:shadow-md hover:ring-1 hover:ring-primary-500/40 dark:bg-fg-dark"
  href={linkUrl}
  target={target ?? "_self"}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  <div class="flex w-full flex-col gap-1">
    {
      imageUrl && (
        <div class="overflow-hidden rounded-lg">
          <img
            class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-105"
            src={imageUrl}
            alt={`Preview of ${title}`}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }

    <div class="flex items-baseline justify-between gap-2">
      <div class="titleViewport min-w-0 flex-1 overflow-hidden">
        <h3 class="contentCardTitle truncate text-lg font-bold first-letter:uppercase">
          {title}
        </h3>
      </div>
      {
        stars ? (
          <p class="shrink-0 text-sm text-text-light/70 dark:text-text-dark/70">
            {stars} ★
          </p>
        ) : null
      }
    </div>

    {
      description && (
        <p class="line-clamp-2 text-sm text-text-light/80 dark:text-text-dark/80">
          {description}
        </p>
      )
    }
  </div>

  {
    tags.length > 0 && (
      <div class="flex flex-wrap items-center gap-1 text-xs font-semibold text-white">
        {tags.map((tag) => (
          <span class="rounded-md bg-primary-600 px-2 py-0.5">{tag}</span>
        ))}
      </div>
    )
  }
</a>

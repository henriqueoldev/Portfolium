---
import { LinkIcon } from "@phosphor-icons/react/dist/ssr";
import Liner from "./Liner.astro";
import SocialIcon from "./SocialIcon.astro";

interface SocialLink {
  iconLink: string;
  name: string;
  link: string;
}

interface Props {
  img: string;
  title: string;
  desc: string;
  socialLinks: Record<string, SocialLink>;
}

const { img, title, desc, socialLinks } = Astro.props;
---

<section
  class="flex h-full flex-col items-center gap-5 overflow-hidden rounded-xl bg-fg-light/60 p-5 backdrop-blur-md sm:flex-row 2xl:text-lg dark:bg-fg-dark"
>
  <div
    class="aspect-square w-32 shrink-0 overflow-hidden rounded-full border-[3px] border-fg-light-400 sm:w-40 dark:border-fg-dark-700"
  >
    <img
      src={img}
      alt={`Portrait of ${title}`}
      class="aspect-square w-full object-cover"
      width="320"
      height="320"
    />
  </div>

  <div class="w-full">
    <a href="/resume" class="group flex items-center justify-center gap-1 sm:justify-start">
      <h1 class="text-3xl font-medium 2xl:text-4xl">{title}</h1>
      <LinkIcon
        class="transition-transform duration-200 group-hover:translate-x-0.5"
        aria-hidden="true"
      />
    </a>

    <div class="my-1">
      <Liner />
    </div>

    <p class="text-left md:text-justify">{desc}</p>

    <div class="mt-2 flex items-center gap-2">
      {
        Object.entries(socialLinks).map(([key, social]) => (
          <a
            href={social.link}
            class="socialLink"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            title={social.name}
          >
            <SocialIcon socialName={social.name} iconLink={social.iconLink} />
          </a>
        ))
      }
    </div>
  </div>
</section>

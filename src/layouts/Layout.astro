---
import userData from "../config/UserData.json";
import Header from "../components/UI/Header.astro"
import "../styles/global.css";
import SideMenu from "../components/UI/SideMenu.astro";
import { ClientRouter } from "astro:transitions";
import { astroCalledServerError } from "astro:actions";

interface Props {
	title: string
}
const {title} = Astro.props
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/bold/style.css"/>
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="color-scheme" content="dark">
		
		<!-- Open Graph Meta Tags -->
		<meta property="og:title" content={userData.name + ' - ' + title} />
		<meta property="og:description" content={userData.shortDesc} />
		<meta property="og:image" content={userData.siteURL + '/favicon.svg'} />
		<meta property="og:url" content={userData.siteURL} />
		<meta property="og:type" content="website" />

		<!-- Essential SEO Meta Tags -->
		<meta name="title" content={userData.name + ' - ' + title} />
		<meta name="description" content={userData.shortDesc} />
		<meta name="keywords" content={"Portfolio, Resume, Projects, Personal, " + userData.name} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={userData.siteURL} />

		<title>{userData.name + ' - ' + title}</title>
	</head>
	<body class="bg-light dark:bg-bg-dark text-text-light dark:text-text-dark overflow-hidden" transition:animate="fade">
		<SideMenu/>
		<div class="flex flex-col justify-center items-center">
			<Header title={userData.name} subTitle={userData.shortDesc}/>
			<slot/>
		</div>
		<ClientRouter/>
	</body>
	<script is:inline>
		document.addEventListener('astro:page-load', () => {
			document.querySelector('html')?.classList.add(localStorage.getItem('theme') || 'dark')
			document.querySelector('meta[name="color-scheme"]')?.setAttribute("content", localStorage.getItem('theme') || 'dark')
			localStorage.setItem('theme', localStorage.getItem('theme') ? localStorage.getItem('theme') || '' : (window.matchMedia("(prefers-color-scheme: dark)") ? 'dark' : 'light'))
			if (localStorage.getItem('theme') == 'dark') {
				document.querySelector('html')?.classList.add('dark')
			}
			document.body.classList.remove('overflow-hidden')
			document.querySelector('.loading')?.classList.add('hidden')
		})
		</script>
</html>